#!/usr/bin/env python3
"""Copy current ISO 27001 SCA check results from wazuh-db into the
wazuh-iso27001-state index, one document per agent+check, record every
result change (e.g. failed -> passed) in wazuh-iso27001-state-history, and
rate every Annex A control from the evidence collectors' metrics.

SCA only raises alerts for some result changes (results that arrive via
integrity sync update wazuh-db silently), so alerts can't show current state.

Control ratings: the collectors (evidence/linux, evidence/windows) send one
evidence event per control; rule 122950 writes them to alerts.json. The latest
event per agent+control is kept in /var/lib/wazuh-iso27001/evidence.json and
scored against /etc/wazuh-iso27001/controls.yml together with the SCA checks
mapped to the control. Results go to wazuh-iso27001-state-controls (one doc
per agent+control) and wazuh-iso27001-state-criteria (one doc per criterion);
rating changes are added to the history index.

Runs from /etc/cron.d/wazuh-iso27001-state; credentials are in
/etc/wazuh-iso27001-sync.conf (user:password, an indexer user that can only
write wazuh-iso27001-state*).
"""
import base64, json, os, sqlite3, ssl, sys, time, urllib.error, urllib.request
from datetime import datetime, timezone

INDEXER = os.environ.get("WAZUH_INDEXER_URL", "https://127.0.0.1:9200").rstrip("/")
INDEX = "wazuh-iso27001-state"
HISTORY = INDEX + "-history"
CONTROLS_INDEX = INDEX + "-controls"
CRITERIA_INDEX = INDEX + "-criteria"
DB_DIR = "/var/ossec/queue/db"
POLICY_PREFIX = "iso27001_"
CONTROLS_FILE = os.environ.get("ISO27001_CONTROLS", "/etc/wazuh-iso27001/controls.yml")
EVIDENCE_STATE = "/var/lib/wazuh-iso27001/evidence.json"
ALERTS = "/var/ossec/logs/alerts/alerts.json"

cred = open("/etc/wazuh-iso27001-sync.conf").readline().strip()
auth = "Basic " + base64.b64encode(cred.encode()).decode()
ctx = ssl._create_unverified_context()


def es(method, path, body, ndjson=False):
    data = body.encode() if ndjson else json.dumps(body).encode()
    req = urllib.request.Request(INDEXER + path, method=method, data=data, headers={
        "Authorization": auth,
        "Content-Type": "application/x-ndjson" if ndjson else "application/json"})
    with urllib.request.urlopen(req, context=ctx, timeout=60) as r:
        return json.load(r)


def query(db, sql, args=()):
    for attempt in range(5):  # wazuh-db may hold a write lock briefly
        try:
            con = sqlite3.connect(f"file:{db}?mode=ro", uri=True, timeout=10)
            try:
                return con.execute(sql, args).fetchall()
            finally:
                con.close()
        except sqlite3.OperationalError as e:
            if "locked" not in str(e) or attempt == 4:
                raise
            time.sleep(2)


def previous(index, fields):
    try:
        res = es("POST", f"/{index}/_search", {"size": 10000, "_source": fields, "query": {"match_all": {}}})
    except urllib.error.HTTPError as e:
        if e.code == 404:
            return {}
        raise
    return {h["_id"]: h["_source"] for h in res["hits"]["hits"]}


def ensure_index(name, properties):
    try:
        es("PUT", "/" + name, {"settings": {"number_of_shards": 1, "number_of_replicas": 0},
                               "mappings": {"properties": properties}})
    except urllib.error.HTTPError as e:
        if e.code != 400 or "resource_already_exists" not in e.read().decode():
            raise


# ------------------------------------------------------------- SCA checks
now = datetime.now(timezone.utc).isoformat()
prev_checks = {k: v["check"]["result"] for k, v in previous(INDEX, ["check.result"]).items()}
changes = 0
agents = query(f"{DB_DIR}/global.db",
               "SELECT id, name, os_name, connection_status FROM agent")
lines, count = [], 0
sca = {}  # (agent id, control) -> {"passed": n, "failed": n, "failing": [titles]}
for aid, name, os_name, status in agents:
    db = f"{DB_DIR}/{int(aid):03d}.db"
    if not os.path.exists(db):
        continue
    try:
        policies = query(db, """SELECT p.id, p.name, s.score, s.end_scan FROM sca_policy p
                                JOIN sca_scan_info s ON s.policy_id = p.id WHERE p.id LIKE ?""",
                         (POLICY_PREFIX + "%",))
    except sqlite3.OperationalError:
        continue  # agent DB without SCA tables yet
    for pid, pname, score, end_scan in policies:
        controls = {}
        for cid, value in query(db, """SELECT c.id, cc.value FROM sca_check c
                                       JOIN sca_check_compliance cc ON cc.id_check = c.id
                                       WHERE c.policy_id = ? AND cc.key = 'iso_27001_2022'""", (pid,)):
            controls.setdefault(cid, []).append(value)
        rules = {}
        for cid, rule in query(db, """SELECT r.id_check, r.rule FROM sca_check_rules r
                                     JOIN sca_check c ON c.id = r.id_check WHERE c.policy_id = ?""", (pid,)):
            rules.setdefault(cid, []).append(rule)
        for cid, title, result, reason, remediation, description in query(
                db, "SELECT id, title, result, reason, remediation, description FROM sca_check WHERE policy_id = ?",
                (pid,)):
            doc = {"agent": {"id": f"{int(aid):03d}", "name": name, "os": os_name, "status": status},
                   "policy": {"id": pid, "name": pname, "score": score, "scan_end": end_scan},
                   "check": {"id": str(cid), "title": title, "result": result or "not applicable",
                             "reason": reason or "", "remediation": remediation or "",
                             "basis": description or "", "rule": rules.get(cid, [])},
                   "control": controls.get(cid, []), "synced_at": now}
            for ctl in doc["control"]:
                s = sca.setdefault((doc["agent"]["id"], ctl), {"passed": 0, "failed": 0, "failing": []})
                if result == "passed":
                    s["passed"] += 1
                elif result == "failed":
                    s["failed"] += 1
                    s["failing"].append(title)
            doc_id = f"{int(aid):03d}_{cid}"
            lines.append(json.dumps({"index": {"_index": INDEX, "_id": doc_id}}))
            lines.append(json.dumps(doc))
            count += 1
            before = prev_checks.get(doc_id)
            if before is not None and before != doc["check"]["result"]:
                changed_at = datetime.fromtimestamp(end_scan, timezone.utc).isoformat()
                lines.append(json.dumps({"index": {"_index": HISTORY, "_id": f"{doc_id}_{end_scan}"}}))
                lines.append(json.dumps({"agent": doc["agent"], "policy": {"id": pid, "name": pname},
                                         "check": {"id": str(cid), "title": title},
                                         "control": doc["control"], "from": before,
                                         "to": doc["check"]["result"], "changed_at": changed_at,
                                         "source": "sync"}))
                changes += 1


# ------------------------------------------------------------- evidence
def coerce(v):
    """Values decoded by analysisd arrive as strings; restore JSON types."""
    if isinstance(v, dict):
        return {k: coerce(x) for k, x in v.items()}
    if isinstance(v, list):
        return [coerce(x) for x in v]
    if v in ("true", "false"):
        return v == "true"
    if v == "null":
        return None
    if isinstance(v, str):
        try:
            return float(v) if any(c in v for c in ".eE") else int(v)
        except ValueError:
            return v
    return v


def load_evidence():
    try:
        state = json.load(open(EVIDENCE_STATE))
    except (OSError, ValueError):
        state = {}
    try:
        with open(ALERTS, errors="replace") as f:
            for line in f:
                if '"iso27001_evidence"' not in line:
                    continue
                try:
                    a = json.loads(line)
                except ValueError:
                    continue
                try:
                    ev = json.loads(a.get("full_log", ""))["iso27001"]
                except (ValueError, KeyError, TypeError):
                    ev = coerce(a.get("data", {}).get("iso27001", {}))
                if not ev.get("control"):
                    continue
                ev["received_at"] = a.get("timestamp")
                slot = state.setdefault(a["agent"]["id"], {})
                cur = slot.get(ev["control"])
                if not cur or str(ev.get("collected_at")) >= str(cur.get("collected_at")):
                    slot[ev["control"]] = ev
    except OSError:
        pass
    os.makedirs(os.path.dirname(EVIDENCE_STATE), mode=0o700, exist_ok=True)
    tmp = EVIDENCE_STATE + ".tmp"
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w") as f:
        json.dump(state, f)
    os.replace(tmp, EVIDENCE_STATE)
    return state


def fmt(v):
    if isinstance(v, bool):
        return "yes" if v else "no"
    if isinstance(v, float):
        return f"{v:g}"
    return "-" if v is None else str(v)


def expected_text(c):
    if "eq" in c:
        return "= " + fmt(c["eq"])
    if "in" in c:
        return "one of " + ", ".join(map(str, c["in"])) + (f" (partial: {', '.join(map(str, c['partial_in']))})" if c.get("partial_in") else "")
    if "range" in c:
        return f"{c['range'][0]} to {c['range'][1]}"
    if "max" in c:
        return f"<= {fmt(c['max'])}" + (f" (partial <= {fmt(c['partial'])})" if "partial" in c else "")
    if "min" in c:
        return f">= {fmt(c['min'])}" + (f" (partial >= {fmt(c['partial'])})" if "partial" in c else "")
    return "information"


def judge(c, metrics):
    """-> (status, credit) where credit is 1, 0.5, 0 or None (not scored)."""
    v = metrics.get(c["metric"])
    if not c.get("weight"):
        return "info", None
    if v is None:
        return ("not applicable", None) if c.get("na_if_missing") else ("no evidence", 0.0)
    try:
        if "eq" in c:
            ok = (v == c["eq"]) if isinstance(c["eq"], bool) or isinstance(v, bool) else float(v) == float(c["eq"])
            return ("pass", 1.0) if ok else ("fail", 0.0)
        if "in" in c:
            if v in c["in"]:
                return "pass", 1.0
            return ("partial", 0.5) if v in c.get("partial_in", []) else ("fail", 0.0)
        v = float(v)
        if "range" in c:
            return ("pass", 1.0) if c["range"][0] <= v <= c["range"][1] else ("fail", 0.0)
        if "max" in c:
            if v <= c["max"]:
                return "pass", 1.0
            return ("partial", 0.5) if "partial" in c and v <= c["partial"] else ("fail", 0.0)
        if "min" in c:
            if v >= c["min"]:
                return "pass", 1.0
            return ("partial", 0.5) if "partial" in c and v >= c["partial"] else ("fail", 0.0)
    except (TypeError, ValueError):
        return "no evidence", 0.0
    return "info", None


def rating_for(score, cfg):
    for band in cfg["ratings"]:
        if score >= band["min"]:
            return band["rating"]
    return cfg["ratings"][-1]["rating"]


rated = rating_changes = 0
try:
    import yaml
    cfg = yaml.safe_load(open(CONTROLS_FILE))
except (ImportError, OSError) as e:
    cfg = None
    print(f"control ratings skipped: {e}", file=sys.stderr)

if cfg:
    kw = {"type": "keyword"}
    agent_map = {"properties": {"id": kw, "name": kw, "os": kw, "status": kw}}
    ensure_index(CONTROLS_INDEX, {
        "agent": agent_map, "control": kw, "control_name": kw, "os_family": kw, "score": {"type": "float"},
        "rating": kw, "evidence_status": kw, "collected_at": {"type": "date"}, "synced_at": {"type": "date"},
        "collector_errors": {"type": "text"}, "evidence": {"type": "text"}, "summary": {"type": "text"},
        "sca": {"properties": {"passed": {"type": "integer"}, "failed": {"type": "integer"},
                               "failing": {"type": "text"}}},
        "criteria_passed": {"type": "integer"}, "criteria_partial": {"type": "integer"},
        "criteria_failed": {"type": "integer"}, "criteria_no_evidence": {"type": "integer"}})
    ensure_index(CRITERIA_INDEX, {
        "agent": agent_map, "control": kw, "control_name": kw, "criterion": kw, "description": kw,
        "metric": kw, "value": kw, "expected": kw, "status": kw, "weight": {"type": "float"},
        "points": {"type": "float"}, "collected_at": {"type": "date"}, "synced_at": {"type": "date"}})
    prev_ratings = previous(CONTROLS_INDEX, ["rating", "score"])
    evidence = load_evidence()
    max_age = cfg.get("evidence_max_age_hours", 26) * 3600
    sca_weight = cfg.get("sca_weight", 15)
    for aid, name, os_name, status in agents:
        aid = f"{int(aid):03d}"
        family = "windows" if "windows" in (os_name or "").lower() else "linux"
        agent = {"id": aid, "name": name, "os": os_name, "status": status}
        ev_agent = evidence.get(aid, {})
        wanted = {c for (a, c) in sca if a == aid} | set(ev_agent)
        for ctl in sorted(wanted):
            spec = cfg["controls"].get(ctl, {"name": ctl, "criteria": []})
            ev = ev_agent.get(ctl)
            if ev and ev.get("collector") in ("linux", "windows"):
                family = ev["collector"]
            metrics = (ev or {}).get("metrics") or {}
            got = earned = 0.0
            counts = {"pass": 0, "partial": 0, "fail": 0, "no evidence": 0}
            crit_docs = []
            for i, c in enumerate(spec["criteria"]):
                if c.get("os") and c["os"] != family:
                    continue
                st, credit = judge(c, metrics) if ev else ("no evidence", 0.0 if c.get("weight") else None)
                if credit is not None:
                    got += c["weight"]
                    earned += c["weight"] * credit
                if st in counts:
                    counts[st] += 1
                crit_docs.append({"agent": agent, "control": ctl, "control_name": spec["name"],
                                  "criterion": f"{i + 1:02d}", "description": c["desc"], "metric": c["metric"],
                                  "value": fmt(metrics.get(c["metric"])), "expected": expected_text(c),
                                  "status": st, "weight": c.get("weight", 0),
                                  "points": round(c["weight"] * credit, 1) if credit is not None else None,
                                  "collected_at": (ev or {}).get("collected_at"), "synced_at": now})
            s = sca.get((aid, ctl))
            if s and s["passed"] + s["failed"]:
                credit = s["passed"] / (s["passed"] + s["failed"])
                got += sca_weight
                earned += sca_weight * credit
                st = "pass" if credit == 1 else "partial" if credit else "fail"
                counts[st] += 1
                crit_docs.append({"agent": agent, "control": ctl, "control_name": spec["name"], "criterion": "SCA",
                                  "description": "SCA baseline checks mapped to this control pass",
                                  "metric": "sca", "value": f"{s['passed']} of {s['passed'] + s['failed']} passed",
                                  "expected": "all passed", "status": st, "weight": sca_weight,
                                  "points": round(sca_weight * credit, 1), "collected_at": None, "synced_at": now})
            score = round(100 * earned / got, 1) if got else 0.0
            if not ev:
                ev_status, rating = "no collector data", "No evidence (SCA only)"
            else:
                age = time.time() - datetime.fromisoformat(str(ev["collected_at"]).replace("Z", "+00:00")).timestamp()
                ev_status = "stale" if age > max_age else "current"
                rating = rating_for(score, cfg)
            doc_id = f"{aid}_{ctl}"
            summary = "; ".join(f"{d['description']}: {d['value']} (need {d['expected']})"
                                for d in crit_docs if d["status"] in ("fail", "no evidence", "partial"))
            doc = {"agent": agent, "control": ctl, "control_name": spec["name"], "os_family": family,
                   "score": score, "rating": rating, "evidence_status": ev_status,
                   "collected_at": (ev or {}).get("collected_at"), "synced_at": now,
                   "evidence": (ev or {}).get("evidence", []), "collector_errors": (ev or {}).get("errors", []),
                   "summary": summary or "All criteria met",
                   "sca": s or {"passed": 0, "failed": 0, "failing": []},
                   "criteria_passed": counts["pass"], "criteria_partial": counts["partial"],
                   "criteria_failed": counts["fail"], "criteria_no_evidence": counts["no evidence"]}
            lines.append(json.dumps({"index": {"_index": CONTROLS_INDEX, "_id": doc_id}}))
            lines.append(json.dumps(doc))
            for d in crit_docs:
                lines.append(json.dumps({"index": {"_index": CRITERIA_INDEX, "_id": f"{doc_id}_{d['criterion']}"}}))
                lines.append(json.dumps(d))
            rated += 1
            before = prev_ratings.get(doc_id)
            if before and before.get("rating") != rating:
                stamp = doc["collected_at"] or now
                lines.append(json.dumps({"index": {"_index": HISTORY, "_id": f"{doc_id}_rating_{stamp}"}}))
                lines.append(json.dumps({"agent": agent, "check": {"id": "rating", "title": f"{ctl} control rating"},
                                         "control": [ctl], "from": f"{before['rating']} ({before.get('score')})",
                                         "to": f"{rating} ({score})", "changed_at": stamp, "source": "rating"}))
                rating_changes += 1

if lines:
    res = es("POST", "/_bulk?refresh=true", "\n".join(lines) + "\n", ndjson=True)
    if res.get("errors"):
        errs = [i["index"]["error"] for i in res["items"] if "error" in i["index"]][:3]
        sys.exit(f"bulk errors: {errs}")
# Drop checks/agents/policies/controls that no longer exist.
gone = 0
for idx in (INDEX, CONTROLS_INDEX, CRITERIA_INDEX) if cfg else (INDEX,):
    gone += es("POST", f"/{idx}/_delete_by_query?refresh=true",
               {"query": {"range": {"synced_at": {"lt": now}}}})["deleted"]
print(f"{now} synced {count} checks, {changes} changed, rated {rated} controls, "
      f"{rating_changes} rating changes, removed {gone} stale")
